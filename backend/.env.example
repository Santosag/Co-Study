# Django Core Settings
DJANGO_SECRET_KEY=django-insecure-co-study-dev-secret-key-change-in-production-12345
DEBUG=True
ALLOWED_HOSTS=*

# Database Settings (mariadb | sqlite)
DB_ENGINE=mariadb
DB_NAME=co_study_db
DB_USER=root
DB_PASSWORD=santosh123
DB_HOST=127.0.0.1
DB_PORT=3306

# CORS Settings (Comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080

# Multi-AI Configuration
# Choose default provider: gemini | openai | claude | groq | deepseek | ollama | openrouter
DEFAULT_AI_PROVIDER=gemini

# 1. Google Gemini (Get free key at: https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

# 2. OpenAI (ChatGPT) (https://platform.openai.com/)
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# 3. Anthropic Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-3-5-haiku-latest

# 4. Groq (Ultra-fast free inference: https://console.groq.com/)
GROQ_API_KEY=
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# 5. DeepSeek (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=
DEEPSEEK_DEFAULT_MODEL=deepseek-chat

# 6. Ollama (Free Local Offline AI: https://ollama.com/)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_DEFAULT_MODEL=llama3.2

# 7. OpenRouter (Access 200+ models: https://openrouter.ai/)
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.3-70b-instruct:free
